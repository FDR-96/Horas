# Copiar a .env y completar. .env no se sube a git.
PORT=3001

# --- Base de datos ---
DB_HOST=192.168.10.8
DB_PORT=5432
DB_NAME=Horas
DB_USER=postgres
# Entre comillas si contiene "#"
DB_PASSWORD=""

# --- Sesiones ---
# Cadena larga y aleatoria. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# --- Panel de administración (/admin/) ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- API Python de alertas (solo la usa server.js; nunca llega al navegador) ---
ALERTS_API_URL=http://127.0.0.1:8000
# Debe coincidir con ADMIN_API_KEY de API/.env
ALERTS_API_KEY=
