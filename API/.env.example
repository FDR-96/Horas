# Copiar a API/.env y completar. API/.env ya está ignorado por git.

# --- Base de datos (la misma que usa server.js) ---
DB_HOST=192.168.10.8
DB_PORT=5432
DB_NAME=Horas
DB_USER=postgres
DB_PASSWORD=

# --- Seguridad ---
# Clave que el panel envía en el header X-API-Key. Usar una cadena larga y aleatoria.
ADMIN_API_KEY=
# Orígenes permitidos para el panel (separados por coma)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# --- Servidor ---
API_HOST=0.0.0.0
API_PORT=8000
TIMEZONE=America/Argentina/Buenos_Aires
HOLIDAYS_COUNTRY=AR
SCHEDULER_ENABLED=true

# --- SMTP ---
# SMTP_SECURITY: starttls (puerto 587) | ssl (puerto 465) | none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=TimeTrack - Alertas
